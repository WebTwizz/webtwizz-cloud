{
  "name": "@webtwizz/cloud",
  "version": "0.4.0",
  "description": "Sign-ins, database and file storage for sites built on WebTwizz Cloud",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebTwizz/webtwizz-cloud.git"
  },
  "homepage": "https://webtwizz.com",
  "keywords": [
    "webtwizz",
    "auth",
    "postgres",
    "storage",
    "nextjs"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "AI_GUIDE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    },
    "./emails": {
      "types": "./dist/emails.d.ts",
      "default": "./dist/emails.js"
    },
    "./AI_GUIDE.md": "./AI_GUIDE.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@better-fetch/fetch": "1.3.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@supabase/auth-js": "2.79.0",
    "better-auth": "1.6.23",
    "jose": "6.2.5",
    "postgres": "3.4.9",
    "server-only": "0.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
